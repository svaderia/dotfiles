snippet doc "C style function documentation with pre and post conditions" b
/** @brief ${1:Function description.}
 * 
 *  @param
 *  @return
 */
endsnippet


snippet bri "C style function brief " b
/** @brief ${1:Function description.} */
endsnippet


snippet fdoc "Doxygen supported file header comment" b
/** @file   ${1:filename.c}
 *  @brief  ${2:brief description for the file}
 *  
 *  TODO: Please add more here. :)
 *
 *  @author Shyamal Vaderia (svaderia)
 *  @bug    ${3:No Known Bugs}
 */
endsnippet

snippet auth "adding author to existing file header" b
*  @author Shyamal Vaderia (svaderia)
endsnippet
